# Copy to .env and edit. NEVER commit .env -- it is git-ignored.
# Every value here is optional: the system starts and runs (CSV/Parquet mode)
# with this file absent.

# --- MetaTrader 5 (optional) ------------------------------------------------
# Leave blank if your terminal is already open and logged in.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Windows path to the terminal, if it is not the default installation.
MT5_PATH=

# --- Time -------------------------------------------------------------------
# Hours the broker's server clock is AHEAD of UTC. Most MT5 brokers run
# UTC+2 (winter) / UTC+3 (summer). Wrong value = wrong session boundaries.
# `python main.py ingest` prints the offset it detects from a live tick.
BROKER_UTC_OFFSET=0

# --- Defaults ---------------------------------------------------------------
DEFAULT_SYMBOLS=XAUUSDm,EURUSDm
DEFAULT_TIMEFRAME=M5
DATA_DIR=
DROP_FORMING_BAR=true
LOG_LEVEL=INFO

# --- Optional AI layer (Phase 22, disabled by default) ----------------------
# The engine never requires this. Absent key = no narration, same numbers.
ANTHROPIC_API_KEY=
ENABLE_CLAUDE=false
